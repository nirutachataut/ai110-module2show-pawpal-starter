classDiagram
    class Owner {
        +str name
        +int available_time
        +list preferences
        +list pets
        +add_pet(pet)
        +remove_pet(pet)
        +get_all_tasks()
        +filter_tasks(pet_name, completed)
        +set_available_time(available_time)
        +update_preferences(preferences)
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
        +remove_task(task)
        +get_tasks()
        +complete_task(task, completed_on)
    }

    class Task {
        +str title
        +int duration_minutes
        +int priority
        +str frequency
        +bool completed
        +str scheduled_time
        +date due_date
        +update_task(title, duration_minutes, priority, frequency)
        +mark_completed()
    }

    class Scheduler {
        +Owner owner
        +list daily_plan
        +list plan_explanation
        +sort_tasks(tasks)
        +sort_by_time(tasks)
        +detect_conflicts()
        +generate_plan()
        +explain_plan()
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : tracks
    Scheduler ..> Owner : reads tasks and availability
    Scheduler ..> Task : sorts and schedules
